# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'PythonBundle'

name = 'tensorboardX'
version = '2.0'
local_pt_version = '1.4.0'
versionsuffix = '-Python-%(pyver)s-PyTorch-1.4.0'

homepage = 'https://github.com/lanpa/tensorboardX/tree/4f13678d8d2b5f0979525425f2a013666790226b'
description = """tensorboard for pytorch (and chainer, mxnet, numpy, ...)"""

toolchain = {'name': 'fosscuda', 'version': '2019b'}

dependencies = [
    ('Python', '3.7.4'),
    ('SciPy-bundle', '2019.10', '-Python-%(pyver)s'), 
    ('PyTorch', local_pt_version, '-Python-%(pyver)s'),
    ('protobuf', '3.10.0'),
    ('torchvision', '0.5.0', versionsuffix),
    ('libsndfile', '1.0.28'),
]

sanity_pip_check = True
use_pip = True

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

exts_list = [
    ('SoundFile', '0.10.3.post1', {
        'modulename': 'soundfile',
        'checksums': ['490cff42650733d1832728b937fe99fa1802896f5ef4d61bcf78cf7ebecb107b'],
    }),
    (name, version, {
        'modulename': 'tensorboardX',
        'checksums': ['835d85db0aef2c6768f07c35e69a74e3dcb122d6afceaf2b8504d7d16c7209a5'],
    }),
]

moduleclass = 'vis'
