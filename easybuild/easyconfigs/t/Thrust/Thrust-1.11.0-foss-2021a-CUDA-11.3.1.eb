# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'CMakeMake'

name = 'Thrust'
version = '1.11.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/NVIDIA/thrust'
description = """The C++ parallel algorithms library."""

toolchain = {'name': 'foss', 'version': '2021a'}

sources = [{
    'filename': SOURCE_TAR_GZ,
    'git_config': {
        'url': 'https://github.com/NVIDIA',
        'repo_name': '%(namelower)s',
        'tag': '%(version)s',
        'recursive': True,
    }
}]
checksums = [None]

builddependencies = [
    ('CMake', '3.20.1'),
    ('binutils', '2.36.1'),
]

dependencies = [
    ('CUDA', '11.3.1', '', True),
]

separate_build_dir = False
buildininstalldir = True

# sed command based on line position in CMakeLists.txt
preconfigopts = 'sed -i 46s/\"ON\"/\"OFF\"/ CMakeLists.txt && '
preconfigopts += 'sed -i 47s/\"ON\"/\"OFF\"/ CMakeLists.txt && '
preconfigopts += 'sed -i 48s/\"ON\"/\"OFF\"/ CMakeLists.txt && '

postinstallcmds = ["cp -r thrust/* ../lib64"]

sanity_check_paths = {
    'files': ['lib/version.h'],
    'dirs': ['lib64']
}

moduleclass = 'lib'
