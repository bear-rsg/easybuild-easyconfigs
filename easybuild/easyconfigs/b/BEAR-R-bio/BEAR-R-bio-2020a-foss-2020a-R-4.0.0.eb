# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Bundle'

name = 'BEAR-R-bio'
version = '2020a'
versionsuffix = '-R-%(rver)s'

homepage = ""
description = """This module provides access to several R bio libraries."""

toolchain = {'name': 'foss', 'version': '2020a'}

dependencies = [
    ('R', '4.0.0'),
    ('R-bundle-Bioconductor', '3.11', versionsuffix),
    ('Cardinal', '2.6.0', versionsuffix),
    ('factoextra', '1.0.7', versionsuffix),
    ('PCAmixdata', '3.1', versionsuffix),
    ('doFuture', '0.10.0', versionsuffix),
    ('furrr', '0.2.1', versionsuffix),
    ('tidymodels', '0.1.0', versionsuffix),
    ('structToolbox', '1.0.1', versionsuffix),
    ('fmi2', '0.2.0', versionsuffix),
    ('mass2adduct', '20210609', versionsuffix),
    ('ottr', '1.0.0', versionsuffix),
    ('ggvenn', '0.1.8', versionsuffix),
    ('qqman', '0.1.8', versionsuffix),
    ('faahKO', '1.28.0', versionsuffix),
    ('pander', '0.6.4', versionsuffix),
    ('iterativeWGCNA', '1.1.6', '-Python-3.8.2%s' % versionsuffix),
    ('iRF', '3.0.0', versionsuffix),
    ('profvis', '0.3.7', versionsuffix),
    ('microbenchmark', '1.4.9', versionsuffix),
    ('M3C', '1.10.0', versionsuffix),
    ('kinship2', '1.8.5', versionsuffix),
    ('qtl2', '0.28', versionsuffix),
    ('ChAMP', '2.18.3', versionsuffix),
]

moduleclass = 'bio'
