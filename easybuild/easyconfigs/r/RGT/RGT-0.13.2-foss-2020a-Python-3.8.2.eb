# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'PythonBundle'

name = 'RGT'  # Regulatory Genomics Toolbox
version = '0.13.2'
versionsuffix = '-Python-%(pyver)s'

homepage = "https://www.regulatory-genomics.org/"
description = """Regulatory Genomics Toolbox is a python library and set of tools for the integrative analysis of 
high throughput regulatory genomics data."""

toolchain = {'name': 'foss', 'version': '2020a'}

dependencies = [
    ('Python', '3.8.2'),
    ('Biopython', '1.78', versionsuffix),
    ('deepTools', '3.5.0', versionsuffix),
    ('scikit-learn', '0.23.2', versionsuffix),
    ('HTSeq', '0.13.5', versionsuffix),
    ('Kent_tools', '411'),
]

sanity_pip_check = True
use_pip = True

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

exts_list = [
    ('fisher', '0.1.9', {
        'checksums': ['d378b3f7e488e2a679c6d0e5ea1bce17bc931c2bfe8ec8424ee47a74f251968d'],
