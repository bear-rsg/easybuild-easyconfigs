    }),
    ('matplotlib-venn', '0.11.6', {
        'checksums': ['d209a9845bb3a54c4247f1ef3f745e4819660ecc9208137097d2a51281f2a478'],
    }),
    ('hmmlearn', '0.2.2', {
        'checksums': ['0492fe138bf6e2b95aa1efadc5124fa02ab01ba75451cd67dcc5f2a2fb282c20'],
    }),
    ('MOODS-python', '1.9.4.1', {
