# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'CMakeMake'

name = 'raven'
version = '1.5.1'

homepage = 'https://github.com/lbcb-sci/raven'
description = """Raven is a de novo genome assembler for long uncorrected reads."""

toolchain = {'name': 'foss', 'version': '2020b'}

github_account = 'lbcb-sci'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['%(version)s.tar.gz']

builddependencies = [
    ('binutils', '2.35'),
    ('CMake', '3.18.4'),
    ('googletest', '1.10.0'),
]

dependencies = [
    ('Cereal', '1.3.0', '', True),
    ('Racon', 'cf09a36'),  # N.B. this needs to be the library version of racon
    ('zlib', '1.2.11'),
]

sanity_check_paths = {
    'files': ['bin/raven'],
    'dirs': []
}

moduleclass = 'bio'
