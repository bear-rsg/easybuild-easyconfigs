# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'PythonBundle'

name = 'iterative-Random_Forest'
version = '0.2.5'

homepage = "https://github.com/Yu-Group/iterative-Random-Forest"
description = """Uses Iterative Random Forests to detect predictive and stable high-order interactions, PNAS 
https://www.pnas.org/content/115/8/1943"""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('Python', '3.8.6'),
    ('SciPy-bundle', '2020.11'),
    ('matplotlib', '3.3.3'),
    ('PyZMQ', '22.1.0'),
    ('IPython', '7.18.1'),
    ('JupyterLab', '2.2.8'),
    ('PyYAML', '5.3.1'),
    ('scikit-learn', '0.23.2'),
]

options = {'fix_python_shebang_for': 'setup.py'}
sanity_pip_check = True
use_pip = True

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

exts_list = [
    ('pydotplus', '2.0.2', {
        'checksums': ['91e85e9ee9b85d2391ead7d635e3d9c7f5f44fd60a60e59b13e2403fa66505c4'],
    }),
    ('pyfpgrowth', '1.0', {
        'checksums': ['a3e5780385241d90d3ae5cabcca767eb65427b0a908014d42164b3ea8899f1d0'],
    }),
    ('py4j', '0.10.9', {
        'checksums': ['36ec57f43ff8ced260a18aa9a4e46c3500a730cac8860e259cbaa546c2b9db2f'],
    }),
    ('pyspark', '3.1.2', {
        'checksums': ['5e25ebb18756e9715f4d26848cc7e558035025da74b4fc325a0ebc05ff538e65'],
    }),
    (name, version, {
        'source_tmpl': 'https://github.com/Yu-Group/iterative-Random-Forest/archive/refs/heads/master.zip',
	'modulename': 'irf',
        'checksums': ['12aff943bb8c731dd9e245d0cc080513371133146bd0b5cefa54c0b8921615fe'],
    }),
]

moduleclass = 'data'
