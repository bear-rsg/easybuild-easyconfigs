# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Bundle'

name = 'kableExtra'
version = '1.3.4'
versionsuffix = '-R-%(rver)s'

homepage = "https://cran.r-project.org/package=kableExtra"
description = """Build complex HTML or 'LaTeX' tables using 'kable()' from 'knitr' and the piping syntax from 
'magrittr'. Function 'kable()' is a light weight table generator coming from 'knitr'. 
This package simplifies the way to manipulate the HTML or 'LaTeX' codes generated by 'kable()' and allows users 
to construct complex tables and customize styles using a readable syntax."""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('R', '4.0.3'),
]

exts_defaultclass = 'RPackage'
exts_filter = ("R -q --no-save", "library(%(ext_name)s)")
exts_default_options = {
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}


# Order is important!
exts_list = [
    ('systemfonts', '1.0.2', {
        'checksums': ['21ac96412846e06a4062362b159213cb9d83bd60fdf03aa235992b6c49fb36a9'],
    }),
    ('svglite', '2.0.0', {
        'checksums': ['76e625fe172a5b7ce99a67b6d631b037b3f7f0021cfe15f2e15e8851b89defa5'],
    }),
    (name, version, {
        'checksums': ['091ffac282cf9257edcec1a06da38b5e6516f111296bedb934e32f5692ffbbb0'],
    }),
]

modextrapaths = {'R_LIBS': ''}

sanity_check_paths = {
    'files': ['kableExtra/R/kableExtra'],
    'dirs': [],
}

moduleclass = 'vis'
