easyblock = 'PythonBundle'

name = 'KneadData'
version = '0.10.0'

homepage = 'http://huttenhower.sph.harvard.edu/kneaddata'
description = """KneadData is a tool designed to perform quality control on metagenomic sequencing data"""

toolchain = {'name': 'foss', 'version': '2021a'}

dependencies = [
    ('Python', '3.9.5'),
    ('SciPy-bundle', '2021.05'),
    ('SAMTools', ),
]

use_pip = True

exts_list = [
    (name, version, {
        'checksums': ['7a6c8d41daf81c92601f00c0065c1b018a0b4e349abf78d662d4191a51ac8588'],
    }),
]

sanity_pip_check = True

moduleclass = 'bio'
