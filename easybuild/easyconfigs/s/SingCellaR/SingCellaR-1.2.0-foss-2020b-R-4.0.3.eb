# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Bundle'

name = 'SingCellaR'
version = '1.2.0'
versionsuffix = '-R-%(rver)s'

homepage = "https://github.com/supatt-lab/SingCellaR"
description = """Description: SingCellaR facilitates standard functionalities necessary for analysis of 
large and sparse 10x Genomics data, and can be applied to gene expression data sets generated by plate-base protocols 
such as Smart-Seq2 and TARGET-seq as well as high-throughput droplet-based platforms."""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('R', '4.0.3'),
    ('R-bundle-Bioconductor', '3.12', '-R-%(rver)s'),
]

exts_defaultclass = 'RPackage'
exts_filter = ("R -q --no-save", "library(%(ext_name)s)")
exts_default_options = {
    'source_urls': [
        'https://bioconductor.org/packages/3.12/bioc/src/contrib/',
        'https://bioconductor.org/packages/3.12/bioc/src/contrib/Archive/%(name)s',
        'https://bioconductor.org/packages/3.12/data/annotation/src/contrib/',
        'https://bioconductor.org/packages/3.12/data/experiment/src/contrib/',
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
        'https://github.com/supatt-lab/SingCellaR/releases/tag/1.2.0',
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}


# Order is important!
exts_list = [
    ('crochet', '2.3.0', {
        'checksums': ['d843444bec547a6c691631931bc68b47c1572bc8935242c992d982cd8c53727f'],
    }),
    ('LinkedMatrix', '1.4.0', {
        'checksums': ['b17f8cbc7c684050ce6bf8b3e324911d62b68729bd5a6f0b1bd27649b395d85c'],
    }),
    ('cccd', '1.5', {
        'checksums': ['f178df54243e5e4da47d38dd3bfcc0ff85e3d4ed980a0a7d80f5e497f5276654'],
    }),
    ('AUCell', '1.12.0', {
        'checksums': ['fd461128d1f4c2e7f879c61af5f142d2f1ef0184f7fc01f28df08816ed707a45'],
    }),
    (name, version, {
        'source_tmpl': '1.2.0.tar.gz',
        'preinstallopts': 'rm src/{SingCellaR.so,RcppExports.o,utils.o} &&',
        'checksums': ['04bec87536903aa61c0d0985c6468c712f8659a4d2b73130f3cd2717ab416dd1'],
    }),
]

modextrapaths = {'R_LIBS': ''}

sanity_check_paths = {
    'files': ['SingCellaR/R/SingCellaR'],
    'dirs': [],
}

moduleclass = 'vis'
