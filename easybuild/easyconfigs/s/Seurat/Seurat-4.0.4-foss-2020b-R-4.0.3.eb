# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Bundle'

name = 'Seurat'
version = '4.0.4'
versionsuffix = '-R-%(rver)s'

homepage = 'https://cran.r-project.org/web/packages/Seurat/index.html'
description = """Seurat is an R package designed for QC, analysis, and exploration of single cell RNA-seq data."""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('R', '4.0.3'),
    ('R-bundle-Bioconductor', '3.12', '-R-%(rver)s'),
]

exts_defaultclass = 'RPackage'
exts_filter = ("R -q --no-save", "library(%(ext_name)s)")
exts_default_options = {
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}


# Order is important!
exts_list = [
    ('spatstat.utils', '2.2-0', {
        'checksums': ['5ad87e524285621dc4ef75c941eba933d980125293ee8f2bef5b7db02f63d7ab'],
    }),
    ('spatstat.data', '2.1-0', {
        'checksums': ['1b9840ad0ec7eddfa98a01e8b8a5291e5cb447c3082aa7d7b4df762577f95533'],
    }),
    ('spatstat.geom', '2.2-2', {
        'checksums': ['83e1908d7a6014035aa0be62ab2f0542bf0598bf78082866f6811862c043a267'],
    }),
    ('spatstat.sparse', '2.0-0', {
        'checksums': ['27fbce64e21f095a5e9ac54c86f91c9f4b45eac3c2358580e04423b4beba19c7'],
    }),
    ('spatstat.core', '2.3-0', {
        'checksums': ['5795ec6db2961dce740c7cd39a9c1b855d92a4af351a794a9bfd634a3f1526c9'],
    }),
    ('Rcpp', '1.0.7', {
        'checksums': ['15e5a4732216daed16263c79fb37017c2ada84a2d4e785e3b76445d0eba3dc1d'],
    }),
    ('Matrix', '1.3-4', {
        'checksums': ['ab42179d44545e99bbdf44bb6d04cab051dd2aba552b1f6edd51ed71b55f6c39'],
    }),
    ('SeuratObject', '4.0.2', {
        'checksums': ['64ee97a221ccaa0bbdc1890da9d3e9cf5b3b9fab037095cfb757db5bbb69cb1c'],
    }),
    (name, version, {
        'checksums': ['8075468da29e0f13433682482b22fc310b8a6f3e0c7ffee9e23a8d5e93d842dd'],
    }),
]

modextrapaths = {'R_LIBS': ''}

sanity_check_paths = {
    'files': ['Seurat/R/Seurat'],
    'dirs': [],
}

moduleclass = 'bio'
