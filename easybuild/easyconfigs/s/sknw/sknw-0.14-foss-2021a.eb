# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'PythonPackage'

name = 'sknw'
version = '0.14'

homepage = "https://github.com/Image-Py/sknw"
description = """Build net work from skeleton image (2D-3D)"""

toolchain = {'name': 'foss', 'version': '2021a'}

dependencies = [
    ('Python', '3.9.5'),
    ('SciPy-bundle', '2021.05'),
    ('numba', '0.53.1'),
    ('networkx', '2.5.1'),
]

sources = [SOURCE_TAR_GZ]
checksums = ['905c0e55a45d96bb922fe120dacc516f29632f5d94c98273519ab9082fc2c3d9']

download_dep_fail = True
sanity_pip_check = True
use_pip = True

moduleclass = 'vis'
