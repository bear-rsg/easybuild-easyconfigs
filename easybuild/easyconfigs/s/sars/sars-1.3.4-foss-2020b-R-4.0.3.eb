# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Bundle'

name = 'sars'
version = '1.3.4'
versionsuffix = '-R-%(rver)s'

homepage = "https://cran.r-project.org/package=sars"
description = """Implements the basic elements of the multi-model inference paradigm for up to twenty species-area 
relationship models (SAR), using simple R list-objects and functions, as in Triantis et al. 2012 
<doi:10.1111/j.1365-2699.2011.02652.x>. 
The package is scalable and users can easily create their own model and data objects. 
Additional SAR related functions are provided."""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('R', '4.0.3'),
]

exts_defaultclass = 'RPackage'
exts_filter = ("R -q --no-save", "library(%(ext_name)s)")
exts_default_options = {
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',  # package archive
        'https://cran.r-project.org/src/contrib/',  # current version of packages
        'https://cran.freestatistics.org/src/contrib',  # mirror alternative for current packages
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}


# Order is important!
exts_list = [
    (name, version, {
        'checksums': ['13c262d20c4c7843489d818305d037040ecf392f7c78a91a93935c89c8072f36'],
    }),
]

modextrapaths = {'R_LIBS': ''}

sanity_check_paths = {
    'files': ['sars/R/sars'],
    'dirs': [],
}

moduleclass = 'data'
