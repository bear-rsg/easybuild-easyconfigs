# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild

easyblock = 'PythonPackage'

name = 'phylophlan'
version = '3.0.2'

homepage = 'https://huttenhower.sph.harvard.edu/phylophlan'
description = """PhyloPhlAn is an integrated pipeline for large-scale phylogenetic profiling of 
  genomes and metagenomes."""

toolchain = {'name': 'foss', 'version': '2021a'}

source_urls = ['https://github.com/biobakery/phylophlan/archive/']
sources = ['%(version)s.tar.gz']

checksums = [
]

dependencies = [
    ('Bowtie2', '2.4.4'),
    ('Perl', '5.32.1'),
    ('Python', '3.9.5'),
    ('SciPy-bundle', '2021.05'),
    ('Biopython', '1.79'),
    ('Seaborn', '0.11.2'),
    ('Pysam', '0.16.0.1'),
    ('DendroPy', '4.5.2'),
    ('CMSeq', '1.0.4'),
    ('biom-format', '2.1.10'),
    ('h5py', '3.2.1'),
]


use_pip = True
sanity_pip_check = True
# Database to be stored in ${BB_APPS_DATA}/MetaPhlAn/3.0.13-foss-2021a

sanity_check_paths = {
    'files': ['lib/python3.9/site-packages/phylophlan/phylophlan.py',
              'bin/phylophlan'],
    'dirs': ['bin'],
}

sanity_check_commands = []

moduleclass = 'bio'
