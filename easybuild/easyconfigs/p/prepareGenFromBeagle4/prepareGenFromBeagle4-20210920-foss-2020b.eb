# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'MakeCp'

name = 'prepareGenFromBeagle4'
version = '20210920'

homepage = "https://mathgen.stats.ox.ac.uk/genetics_software/shapeit/shapeit.html"
description = """This program merges all the VCFs produced by Beagle4 in step 3 and produces proper whole chromosome 
input files for SHAPEIT."""

toolchain = {'name': 'foss', 'version': '2020b'}

source_urls = ['https://mathgen.stats.ox.ac.uk/genetics_software/shapeit/files/']
sources = ['prepareGenFromBeagle4.tgz']
checksums = [
    '6a4cfe257e1edd099c479fc7b223b912bf5c1884863bbf1a4654db73f828c30c',  # prepareGenFromBeagle4.tgz
]

dependencies = [
    ('Boost', '1.74.0'),
    ('zlib', '1.2.11'),
]

prebuildopts = "make clean && "

files_to_copy = ['*']

sanity_check_paths = {
    'files': ['bin/prepareGenFromBeagle4'],
    'dirs': [""]
}

moduleclass = 'bio'
