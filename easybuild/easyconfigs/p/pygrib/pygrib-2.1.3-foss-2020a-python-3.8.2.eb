easyblock = 'PythonPackage'

name = 'pygrib'
version = '2.1.3'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://jswhit.github.io/pygrib'
description = "Python interface for reading and writing GRIB data"

toolchain = {'name': 'foss', 'version': '2020a'}

source_urls = [PYPI_SOURCE]
sources = [SOURCE_TAR_GZ]
checksums = ['a22552e2e58c9eb9b5750a2d5a8f055334ad2a6a4fb8a6d56261356196ebe651']

dependencies = [
    ('Python', '3.8.2'),
    ('JasPer', '2.0.14'),
    ('ecCodes', '2.20.0'),
    ('SciPy-bundle', '2020.03', versionsuffix),
    ('pyproj', '2.6.1.post1', versionsuffix),
    ('zlib', '1.2.11'),
]

download_dep_fail = True
use_pip = True

preinstallopts = "export JASPER_DIR=$EBROOTJASPER GRIBAPI_DIR=$EBROOTECCODES ZLIB_DIR=$EBROOTZLIB &&"

moduleclass = 'data'
