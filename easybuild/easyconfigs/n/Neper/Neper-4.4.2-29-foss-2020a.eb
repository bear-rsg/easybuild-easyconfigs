# This easyconfig was created by Simon Branford of the BEAR Software team at the University of Birmingham.
easyblock = 'CMakeMake'

name = 'Neper'
# prerelease, with fix for bug user encountered
version = '4.4.2-29'
_hash = '5d165e4'

homepage = "https://neper.info/"
description = """Neper is a software package for polycrystal generation and meshing. It can deal with 2D and 3D
 polycrystals with very large numbers of grains."""

toolchain = {'name': 'foss', 'version': '2020a'}

# https://github.com/rquey/neper/
github_account = 'rquey'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['%s.tar.gz' % _hash]
checksums = ['54060cb98b9c0a09045cf8b15dec3ea780dd06c5f3a177d43596c2d3b857d2c1']

builddependencies = [('CMake', '3.16.4')]

dependencies = [
    ('gmsh', '4.7.1', '-Python-3.8.2'),
    ('GSL', '2.6'),
    ('libpng', '1.6.37'),
    ('NLopt', '2.6.1'),
    ('POV-Ray', '3.7.0.8'),
    ('SCOTCH', '6.0.9'),
    ('zlib', '1.2.11'),
]

start_dir = 'src'
preconfigopts = "sed -i 's|/usr/share|%(installdir)s/share|' ../neper-*/src/CMakeLists.txt && "
configopts = ' -DBUILD_TESTING_MODE=Minimal'
runtest = 'test ARGS="-V"'

sanity_check_paths = {
    'files': ['bin/neper'],
    'dirs': [],
}

sanity_check_commands = ['%(namelower)s --help']

moduleclass = 'cae'
