# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'Tarball'

name = 'MPFR-C++'
version = '3.6.9'

homepage = "https://github.com/advanpix/mpreal"
description = """MPFR C++ (MPREAL): Multiple precision floating point arithmetic library for C++."""

toolchain = {'name': 'GCCcore', 'version': '10.3.0'}

source_urls = ['https://github.com/advanpix/mpreal/archive/refs/tags/']
sources = ['mpfrc++-%(version)s.tar.gz']
checksums = ['7ff631e530778f459d74aff624868a7a2aed91c0f694ed32bd6c3501dc7f8540']

modextrapaths = {'CPLUS_INCLUDE_PATH': ''}

sanity_check_paths = {
    'files': ['mpreal.h'],
    'dirs': [],
}

moduleclass = 'math'
