easyblock = 'ConfigureMake'

name = 'MashMap'
version = '2.0'

homepage = 'https://github.com/marbl/MashMap'
description = """MashMap implements a fast and approximate algorithm for computing local alignment boundaries
between long DNA sequences."""

toolchain = {'name': 'foss', 'version': '2020b'}

source_urls = ['https://github.com/marbl/MashMap/archive/refs/heads/']
sources = ['master.zip']
patches = ['MashMap-2.0_add_extern_c.patch']
checksums = [
    '48579521db0e7b4274be8ce83802c41adce6db59c7ffcbb81b8cfebaa925b976',  # master.zip
    '204fa0e484c625a01a91de82e5ccf9f4d209181e7d624add1b9589438a514414',  # MashMap-2.0_add_extern_c.patch
]

dependencies = [
    ('Autoconf', '2.69'),
    ('Boost', '1.74.0'),
    ('zlib', '1.2.11'),
    ('GSL', '2.6'),
]

preconfigopts = 'autoreconf && '

#preconfigopts += 'echo -e "\nextern \x22C\x22 \n\n{ \nvoid *__wrap_memcpy(void *dest, const void *src, size_t n) \n{ \n    return memcpy(dest, src, n); \n} \n}" >> src/common/memcpyLink.h && '

configopts = "--with-boost=$EBROOTBOOST --with-gsl=$EBROOTGSL"

#configure_cmd = './bootstrap.sh ./configure --with-boost=$EBROOTBOOST'

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': [],
}


moduleclass = 'bio'
