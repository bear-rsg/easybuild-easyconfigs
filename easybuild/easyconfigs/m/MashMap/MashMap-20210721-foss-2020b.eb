easyblock = 'ConfigureMake'

name = 'MashMap'
version = '2.0'
_hash = '74ff338'

homepage = 'https://github.com/marbl/MashMap'
description = """MashMap implements a fast and approximate algorithm for computing local alignment boundaries
between long DNA sequences."""

toolchain = {'name': 'foss', 'version': '2020b'}

github_account = 'marbl'
source_urls = [GITHUB_SOURCE]
sources = [{'download_filename': '%s.tar.gz' % _hash, 'filename': SOURCELOWER_TAR_GZ}]
patches = ['MashMap-20210721_add_extern_c.patch']
checksums = [
    'b15233c945e419eb8eb18ac5359eaafabcbf2b0308c0ce56e1651c48bee9b41a',  # mashmap-2.0.tar.gz
    '204fa0e484c625a01a91de82e5ccf9f4d209181e7d624add1b9589438a514414',  # MashMap-20210721_add_extern_c.patch
]

#source_urls = ['https://github.com/marbl/MashMap/tree/']
#sources = ['74ff33811321213b96a7a065594cc1509572d010']
dependencies = [
    ('Autoconf', '2.69'),
    ('Boost', '1.74.0'),
    ('zlib', '1.2.11'),
    ('GSL', '2.6'),
]

preconfigopts = 'autoreconf && '

configopts = "--with-boost=$EBROOTBOOST --with-gsl=$EBROOTGSL"

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': [],
}

moduleclass = 'bio'
