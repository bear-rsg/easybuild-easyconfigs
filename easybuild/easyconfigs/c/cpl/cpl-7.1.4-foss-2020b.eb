easyblock = 'ConfigureMake'

name = 'cpl'
version = '7.1.4'
homepage = "https://www.eso.org/sci/software/cpl/"
description = """Efficient and robust software toolkit to develop astronomical data-reduction tasks 
(known as "recipes")."""

toolchain = {'name': 'foss', 'version': '2020b'}

source_urls = ['https://ftp.eso.org/pub/dfs/pipelines/libraries/cpl']
sources = ['%(name)s-%(version)s.tar.gz']
checksums = ['cb43adba7ab15e315fbfcba4e2d8b88fa56d29a5a16036a7f082621b8416bd6c']

dependencies = [
    ('Python', '3.8.6'),
    ('SciPy-bundle', '2020.11'),
    ('matplotlib', '3.3.3'),
    ('libtool', '2.4.6'),
    ('CFITSIO', '3.49', '-threads'),
    ('wcslib', '7.6'),
    ('erfa', '20210727'),
]

configure_cmd = "./configure --enable-reentrant"
preinstallopts = "make check && "

sanity_check_paths = {
    'files': ['include/cpl.h'],
    'dirs': ['lib/'],
}

moduleclass = 'data'
