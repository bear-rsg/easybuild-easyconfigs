#        'checksums': ['aaf1cfc9ffe3a4c6684247899924e1c18306971dfef4bae1dc596a2fb42a64a9'],
#    }),
    (name, version, {
        'preinstallopts': "rm src/{CellChat.so,RcppExports.o,CellChat_Rcpp.o} &&",
        'source_tmpl': 'af7e152.tar.gz',
        'checksums': ['db15371d440222ed34577025225799f2722e3478000678dcb799b92625ddb594'],
    }),
]

modextrapaths = {'R_LIBS': ''}

sanity_check_paths = {
    'files': ['CellChat/R/CellChat'],
    'dirs': [],
}

moduleclass = 'bio'
