easyblock = 'PerlModule'

name = 'Config-IniFiles'
version = '3.000003'

homepage = 'https://metacpan.org/dist/Config-IniFiles'
description = "Config-IniFiles"

toolchain = {'name': 'GCCcore', 'version': '10.3.0'}

source_urls = ['https://cpan.metacpan.org/authors/id/S/SH/SHLOMIF']
sources = [SOURCE_TAR_GZ]
checksums = ['3c457b65d98e5ff40bdb9cf814b0d5983eb0c53fb8696bda3ba035ad2acd6802']

builddependencies = [
    ('binutils', '2.36.1'),
]

dependencies = [
    ('Perl', '5.32.1'),
]

options = {'modulename': 'Config::IniFiles'}

sanity_check_paths = {
    'files': ['lib/perl5/site_perl/%(perlver)s/Config/IniFiles.pm'],
    'dirs': ['lib/perl5/site_perl/%(perlver)s/Config'],
}

moduleclass = 'data'
