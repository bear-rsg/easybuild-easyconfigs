# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'PythonBundle'

name = 'CellPhoneDB'
version = '3.1.0'
versionsuffix = '-Python-%(pyver)s'  

homepage = "https://github.com/ventolab/CellphoneDB"
description = """CellPhoneDB can be used to search for a particular ligand/receptor, 
or interrogate your own HUMAN single-cell transcriptomics data."""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('Python', '3.8.6'),
    ('SciPy-bundle', '2020.11'), # Chose this toolchain for version of pandas and numpy
    ('tqdm', '4.56.2'),
    ('R', '4.0.3'),
]

sanity_pip_check = True
use_pip = True

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

