    'https://github.com/zopefoundation/zope.interface': [PYPI_SOURCE],
    'https://github.com/stefankoegl/python-json-patch/blob/master/doc/index.rst': [PYPI_SOURCE],
    'https://github.com/stefankoegl/python-json-pointer': [PYPI_SOURCE],
    'https://github.com/bshillingford/python-torchfile': [PYPI_SOURCE],
    'https://www.tornadoweb.org/en/stable/': [PYPI_SOURCE],
}

