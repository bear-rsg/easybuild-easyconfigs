dependencies = [
    ('Java', '11.0.2', '', True),
    ('Python', '3.8.6'),
    ('R', '4.0.3'),
    ('esorex', '3.13.5'),
]

sanity_check_paths = {
    'files': ['esoreflex/bin/esoreflex'],
    'dirs': [],
}

moduleclass = 'vis'
