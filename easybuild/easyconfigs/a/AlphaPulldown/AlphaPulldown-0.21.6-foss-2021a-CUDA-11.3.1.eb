easyblock = 'PythonBundle'

name = 'AlphaPulldown'
version = '0.21.6'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/KosinskiLab/AlphaPulldown'
description = """AlphaPulldown is a Python package that streamlines protein-protein interaction screens and
 high-throughput modelling of higher-order oligomers using AlphaFold-Multimer."""

toolchain = {'name': 'foss', 'version': '2021a'}

dependencies = [
    ('Python', '3.9.5'),
    ('AlphaFold', '2.2.2', versionsuffix),
    ('CUDA', '11.3.1', '', True),
    ('JupyterLab', '3.2.5'),
    ('matplotlib', '3.4.2'),
]

use_pip = True
sanity_pip_check = True

exts_list = [
    ('importlib_resources', '5.9.0', {
        'checksums': ['5481e97fb45af8dcf2f798952625591c58fe599d0735d86b10f54de086a61681'],
    }),
    ('py3Dmol', '1.8.1', {
        'modulename': 'py3Dmol',
        'checksums': ['10bb3022c5db3e5e6d66f51d7d4118afaf939726d655f08761709ddf032cb31d'],
    }),
    (name, version, {
        'patches': ['AlphaPulldown-deps.patch'],
        'source_tmpl': '%(namelower)s-%(version)s.tar.gz',
        'checksums': [
            'd35e156c40c839cd903b13a1e18a9ae2e20dff32a54d53a67f9a2c7c64b67c2b',  # alphapulldown-0.21.6.tar.gz
            '6371bf16071e3ab4bff2ee076a6572780bb392ae728e18cf3678fd24270d5a95',  # AlphaPulldown-deps.patch
        ],
    }),
]

moduleclass = 'bio'
