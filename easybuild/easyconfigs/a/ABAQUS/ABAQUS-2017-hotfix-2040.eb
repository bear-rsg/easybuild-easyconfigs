name = 'ABAQUS'
version = '2017'
local_hotfix = '2040'
versionsuffix = '-hotfix-%s' % local_hotfix

homepage = 'https://www.3ds.com/products-services/simulia/products/abaqus/'
description = """Finite Element Analysis software for modeling, visualization and best-in-class implicit and explicit
 dynamics FEA."""

toolchain = SYSTEM

sources = [
    '%(version)s/%(version)s.AM_SIM_Abaqus_Extend.AllOS.1-6.tar',
    '%(version)s/%(version)s.AM_SIM_Abaqus_Extend.AllOS.2-6.tar',
    '%(version)s/%(version)s.AM_SIM_Abaqus_Extend.AllOS.3-6.tar',
    '%(version)s/%(version)s.AM_SIM_Abaqus_Extend.AllOS.4-6.tar',
    '%(version)s/%(version)s.AM_SIM_Abaqus_Extend.AllOS.5-6.tar',
    '%(version)s/%(version)s.AM_SIM_Abaqus_Extend.AllOS.6-6.tar',
    # hotfixes
    '%%(version)s/%%(version)s.FP.CFA.%s.Part_3DEXP_SimulationServices.Linux64.tar' % local_hotfix,
    '%%(version)s/%%(version)s.FP.CFA.%s.Part_SIMULIA_Abaqus_CAE.Linux64.tar' % local_hotfix,
]

moduleclass = 'cae'
