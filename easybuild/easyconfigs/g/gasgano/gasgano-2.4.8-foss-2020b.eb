easyblock = 'Tarball'

name = 'gasgano'
version = '2.4.8'
homepage = 'https://www.eso.org/sci/software/esoreflex/'
description = """Data File Organiser developed and maintained by ESO to help its user community to manage and 
organise in a systematic way the astronomical data observed and produced by all VLT compliant telescopes, 
i.e. by telescopes which are being operated through Observation Blocks."""

toolchain = {'name': 'foss', 'version': '2020b'}

source_urls = ['https://ftp.eso.org/pub/dfs/gasgano']
sources = ['%(name)s-%(version)s.tar.gz']
checksums = ['437a5d276123c8b5441d295004f89455f11cff8d62774c70e377dabf75dec13f']

dependencies = [
    ('Java', '1.8.0_292-OpenJDK', '', True),
]

sanity_check_paths = {
    'files': ['bin/gasgano'],
    'dirs': ['share/'],
}

moduleclass = 'vis'
