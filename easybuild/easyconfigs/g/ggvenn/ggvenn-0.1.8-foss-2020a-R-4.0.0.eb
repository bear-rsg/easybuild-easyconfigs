easyblock = 'Bundle'

name = 'ggvenn'
version = '0.1.8'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/yanlinlin82/ggvenn/'
description = """Venn diagrams with ggplot2"""

toolchain = {'name': 'foss', 'version': '2020a'}

dependencies = [
    ('R', '4.0.0'),
]

exts_defaultclass = 'RPackage'

exts_default_options = {
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
    'source_urls': ['https://cran.r-project.org/src/contrib/',
                    'https://github.com/yanlinlin82/ggvenn/archive/refs/tags/'],
}

exts_list = [
    (name, version, {
        'source_tmpl': 'v%(version)s.tar.gz',
    }),
]

modextrapaths = {'R_LIBS': ''}

sanity_check_paths = {
    'files': [],
    'dirs': [name],
}

moduleclass = 'geo'
