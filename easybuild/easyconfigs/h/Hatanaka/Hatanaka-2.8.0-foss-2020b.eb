# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'PythonBundle'

name = 'Hatanaka'
version = '2.8.0'

homepage = "https://github.com/valgur/hatanaka"
description = """Effortless compression / decompression of RINEX files in Python and on the command line."""

toolchain = {'name': 'foss', 'version': '2020b'}

dependencies = [
    ('Python', '3.8.6'),
    ('pybind11', '2.6.0'),
]

sanity_pip_check = True
use_pip = True

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

exts_list = [
    ('importlib_resources', '5.9.0', {
        'checksums': ['5481e97fb45af8dcf2f798952625591c58fe599d0735d86b10f54de086a61681'],
    }),
    ('ncompress', '1.0.0', {
        'checksums': ['e7bbf10cca1376f4f17ae2c447e33a9d4067525abb0c71d488c9a5ced50552f1'],
    }),
    ('hatanaka', version, {
        'checksums': ['84faa953b4f641a6d3cf8187f1775ba7e7f8d815f7bcd48cfb18553b766cbc41'],
    }),
]

moduleclass = 'geo'
